{
  "name": "johannesfischer.github.io",
  "version": "1.0.0",
  "description": "My github page",
  "main": "index.js",
  "author": "Johannes Fischer <mail@johannes-fischer.de>",
  "homepage": "https://github.com/JohannesFischer/johannesfischer.github.io#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/JohannesFischer/johannesfischer.github.io.git"
  },
  "type": "module",
  "scripts": {
    "dev": "vite",
    "format": "prettier . --write",
    "lint": "npx eslint src",
    "prepare": "panda codegen && npx simple-git-hooks",
    "test": "echo \"Error: no test specified\" && exit 1",
    "build": "vite build",
    "preview": "vite preview",
    "predeploy": "npm run build",
    "deploy": "gh-pages -d dist -u \"github-actions-bot <github-actions@github.com>\" --repo https://x-access-token:${GITHUB_TOKEN}@github.com/<your-username>/<your-repo-name>.git",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build -o dist/storybook",
    "build-storybook-docs": "npm run build-storybook -- --docs",
    "chromatic": "npx chromatic"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.4",
    "@pandacss/dev": "^1.9.1",
    "@pandacss/studio": "^1.11.1",
    "@storybook/addon-docs": "^10.4.1",
    "@storybook/addon-themes": "^10.4.1",
    "@storybook/react-vite": "^10.4.1",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.1",
    "chromatic": "^17.1.0",
    "eslint": "^9.39.4",
    "eslint-plugin-perfectionist": "^5.9.0",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.5.2",
    "eslint-plugin-storybook": "^10.4.1",
    "globals": "^17.4.0",
    "lint-staged": "^16.4.0",
    "prettier": "3.8.1",
    "simple-git-hooks": "^2.13.1",
    "storybook": "^10.4.1",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.58.0",
    "vite": "^8.0.16"
  },
  "simple-git-hooks": {
    "pre-commit": "npx lint-staged"
  },
  "lint-staged": {
    "*.{ts,tsx}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{css,json,md}": "prettier --write"
  },
  "overrides": {
    "postcss": ">=8.5.10"
  },
  "dependencies": {
    "lucide-react": "^1.6.0",
    "motion": "^12.38.0",
    "react": "^19.2.4",
    "react-dom": "^19.2.4"
  }
}
